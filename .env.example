DATABASE_URL="postgresql://user:password@host:5432/dbname"
SESSION_SECRET="replace-with-a-long-random-value"
CRON_SECRET="replace-with-a-long-random-value"
INTOUCH_API_KEY="same account-level key as movehub-invoicing/sales-progression/tspc-invoicing"
APP_URL="https://commissions.move-hub.co.uk"

# Staff sync with movehub-holidays — adding/disabling/deleting someone here
# also pushes that change there, and vice versa. Same secret must be set on
# both apps. Leaving either unset just disables the sync (no error).
PEER_APP_URL="https://holidays.move-hub.co.uk"
STAFF_SYNC_SECRET="replace-with-a-long-random-value-shared-with-movehub-holidays"
