generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  STAFF
}

enum UserStatus {
  INVITED
  ACTIVE
  DISABLED
}

enum ResetRequestStatus {
  PENDING
  APPROVED
  DISMISSED
  USED
}

// Result of automatically checking an uploaded invoice against our completion
// data (see src/lib/invoiceCheck.ts). Advisory only — never blocks an upload.
enum InvoiceCheckStatus {
  NOT_CHECKED
  PASSED
  FLAGGED
  UNREADABLE
}

enum BonusType {
  DISCRETIONARY
  REFERRAL
}

enum SelfBilledStatus {
  DRAFT
  ISSUED
  QUERIED
  ACCEPTED
  PAID
  // A draft discarded, or a queried invoice replaced by a reissue. Kept (with
  // its number, if it had one) so the number sequence has no unexplained gaps.
  VOID
}

enum SelfBilledKind {
  INVOICE
  CREDIT_NOTE
}

enum AcceptedHow {
  CONFIRMED
  DEEMED
}

enum SelfBilledLineType {
  COMPLETION
  PERFORMANCE_BONUS
  ADHOC_BONUS
  REFERRAL_FEE
  ADJUSTMENT
}

enum InvoiceStatus {
  PENDING
  PAID
}

// ─── Staff login ───────────────────────────────────────────────────────────

model User {
  id           String     @id @default(cuid())
  name         String?
  email        String     @unique
  passwordHash String?
  role         Role       @default(STAFF)
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now())

  // Must exactly match InTouch's feeEarnerFullName for this person, so
  // completions/open-file counts attribute to them correctly. Null until an
  // admin sets it (e.g. right after invite, or if InTouch naming changes).
  intouchFeeEarnerName String?

  inviteToken       String?   @unique
  inviteTokenExpiry DateTime?

  // Set when movehub-holidays reports this person was deleted there, but they
  // had a real (non-INVITED) account here — status flips to DISABLED
  // immediately, but the actual delete needs an explicit admin confirmation
  // rather than happening automatically. See src/lib/peerSync.ts.
  peerDeleteRequestedAt   DateTime?
  peerDeleteRequestedFrom String?

  resetRequests         PasswordResetRequest[] @relation("Requester")
  resolvedResetRequests PasswordResetRequest[] @relation("Resolver")
  snapshots             MonthlySnapshot[]
  completedMatters      CompletedMatter[]
  invoices              StaffInvoice[]         @relation("InvoiceOwner")
  uploadedInvoices      StaffInvoice[]         @relation("InvoiceUploader")
  bonuses               BonusPayment[]         @relation("BonusOwner")
  recordedBonuses       BonusPayment[]         @relation("BonusRecorder")
  bankDetails           StaffBankDetails?      @relation("BankDetailsOwner")
  editedBankDetails     StaffBankDetails[]     @relation("BankDetailsEditor")
  staffDetails          StaffDetails?          @relation("StaffDetailsOwner")
  editedStaffDetails    StaffDetails[]         @relation("StaffDetailsEditor")
  capacityChanges       CapacityChange[]       @relation("CapacityChangeOwner")
  madeCapacityChanges   CapacityChange[]       @relation("CapacityChangeEditor")
  agreements            SelfBillingAgreement[] @relation("AgreementOwner")
  endedAgreements       SelfBillingAgreement[] @relation("AgreementEnder")
  selfBilledInvoices    SelfBilledInvoice[]    @relation("SelfBilledOwner")
  issuedSelfBilled      SelfBilledInvoice[]    @relation("SelfBilledIssuer")
}

model PasswordResetRequest {
  id           String             @id @default(cuid())
  userId       String
  status       ResetRequestStatus @default(PENDING)
  token        String?            @unique
  tokenExpiry  DateTime?
  resolvedById String?
  resolvedAt   DateTime?
  createdAt    DateTime           @default(now())

  user       User  @relation("Requester", fields: [userId], references: [id], onDelete: Cascade)
  resolvedBy User? @relation("Resolver", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([status])
}

// ─── One snapshot per user per month: "how many open files did they have ──
// when this month started". Captured automatically (see src/lib/snapshot.ts)
// via a CRON_SECRET-protected endpoint, meant to run on/shortly after the 1st.

model MonthlySnapshot {
  id               String   @id @default(cuid())
  userId           String
  year             Int
  month            Int // 1-12
  fileCountAtStart Int
  createdAt        DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, year, month])
  @@index([userId])
}

// ─── One row per InTouch matter whose "Completion" task is done ───────────
// Dedup'd by intouchGuid so a repeat sync never double-counts. userId is
// resolved by matching the matter's feeEarnerFullName against
// User.intouchFeeEarnerName at sync time; null (with handlerName still set)
// means no match was found. Each User is a fixed one-to-one link to a real
// person's email, so a mismatch is fixed by correcting their fee earner
// name on the Staff page, not by manually reassigning individual matters.

model CompletedMatter {
  id             String   @id @default(cuid())
  userId         String?
  intouchGuid    String   @unique
  address        String
  postcode       String?
  handlerName    String?
  completionDate DateTime
  createdAt      DateTime @default(now())

  // Set once this completion is on a self-billed invoice line, so it's never
  // billed twice; a completion synced after its month's invoice was raised has
  // no line yet and rolls onto the next invoice. Cleared if that invoice is
  // voided (draft discarded or reissued).
  selfBilledLineId String?

  user           User?                  @relation(fields: [userId], references: [id], onDelete: SetNull)
  selfBilledLine SelfBilledInvoiceLine? @relation("LineCompletions", fields: [selfBilledLineId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([completionDate])
  @@index([selfBilledLineId])
}

// ─── Invoices staff submit (or an admin uploads on their behalf) against ───
// commission owed. Deliberately NOT tied to a specific calendar month — an
// invoice can cover one slow month or several combined, so "outstanding" is
// computed as lifetime commission earned (see src/lib/payments.ts) minus the
// sum of invoices marked PAID, not a per-month reconciliation.

model StaffInvoice {
  id           String        @id @default(cuid())
  userId       String?
  uploadedById String?
  amountPence  Int
  fileName     String
  fileMimeType String
  fileData     Bytes
  status       InvoiceStatus @default(PENDING)
  paidAt       DateTime?
  createdAt    DateTime      @default(now())

  checkStatus InvoiceCheckStatus @default(NOT_CHECKED)
  checkResult Json?
  checkedAt   DateTime?

  // Both SetNull (not the invoice's own delete) so a payment record — real
  // financial history — outlives either the staff member's login or the
  // admin who happened to upload it, same precedent as CompletedMatter.
  user       User? @relation("InvoiceOwner", fields: [userId], references: [id], onDelete: SetNull)
  uploadedBy User? @relation("InvoiceUploader", fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([userId])
}

// ─── Ad-hoc bonuses ─────────────────────────────────────────────────────────
// A one-off amount owed to someone that has nothing to do with completions
// (e.g. a discretionary bonus). It counts towards what they're owed — staff
// invoice it alongside their regular commission, so the invoice sense-check
// and "outstanding" both need to include it — but it's kept as its own record
// rather than folded into commission, so the monthly commission figures stay
// purely completion-driven.

model BonusPayment {
  id           String    @id @default(cuid())
  userId       String?
  recordedById String?
  amountPence  Int
  note         String
  type         BonusType @default(DISCRETIONARY)
  awardedAt    DateTime  @default(now())
  createdAt    DateTime  @default(now())

  // Same "billed once, late items roll forward" link as CompletedMatter.
  selfBilledLineId String?
  selfBilledLine   SelfBilledInvoiceLine? @relation("LineBonuses", fields: [selfBilledLineId], references: [id], onDelete: SetNull)

  // SetNull on both, same precedent as StaffInvoice: financial history
  // outlives the login of whoever it was for or whoever recorded it.
  user       User? @relation("BonusOwner", fields: [userId], references: [id], onDelete: SetNull)
  recordedBy User? @relation("BonusRecorder", fields: [recordedById], references: [id], onDelete: SetNull)

  @@index([userId])
}

// ─── Staff bank details ─────────────────────────────────────────────────────
// Where someone's commission gets paid. Only they and admins can see it. The
// account name, sort code and account number are stored together as one
// AES-256-GCM encrypted blob (key: BANK_DETAILS_KEY, see src/lib/bankDetails.ts)
// so a database leak alone doesn't expose them; accountNumberLast4 is kept in
// the clear only so lists can show "ending 1234" without decrypting.
// Used by the invoice check to confirm an invoice asks to be paid into the
// account on file. Cascade-deleted with the user — personal data, not history.

model StaffBankDetails {
  id                 String    @id @default(cuid())
  userId             String    @unique
  encrypted          String
  accountNumberLast4 String
  // Set only when existing details are replaced (not on first entry). The
  // invoice check flags any invoice whose owner changed details since their
  // last paid invoice — the classic way payments get redirected.
  lastChangedAt      DateTime?
  updatedById        String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  user      User  @relation("BankDetailsOwner", fields: [userId], references: [id], onDelete: Cascade)
  updatedBy User? @relation("BankDetailsEditor", fields: [updatedById], references: [id], onDelete: SetNull)
}

// ─── Staff details: invoice identity + max open cases ──────────────────────
// What goes on a progressor's self-billed invoice (legal/trading name, address,
// VAT status) plus the most open cases they're willing to carry. Staff edit their
// own; admins can edit anyone's. Issued invoices will snapshot these fields, so
// this row is current-state only and cascades with the user (personal data,
// same as StaffBankDetails).
//
// maxOpenCases is the master copy for movehub-sales-progression's
// StaffUser.capacity (dashboard + Imports page): every change is pushed there by
// email (src/lib/capacitySync.ts). capacitySync* records the last push attempt.

model StaffDetails {
  id                String    @id @default(cuid())
  userId            String    @unique
  legalName         String?
  addressLine1      String?
  addressLine2      String?
  city              String?
  postcode          String?
  vatRegistered     Boolean   @default(false)
  vatNumber         String?
  maxOpenCases      Int?
  capacitySyncedAt  DateTime?
  capacitySyncError String?
  updatedById       String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user      User  @relation("StaffDetailsOwner", fields: [userId], references: [id], onDelete: Cascade)
  updatedBy User? @relation("StaffDetailsEditor", fields: [updatedById], references: [id], onDelete: SetNull)
}

// Audit trail of max-open-cases changes (staff set their own; admins can
// override), so a disputed figure can be traced to who changed it and when.

model CapacityChange {
  id          String   @id @default(cuid())
  userId      String
  fromValue   Int?
  toValue     Int?
  changedById String?
  createdAt   DateTime @default(now())

  user      User  @relation("CapacityChangeOwner", fields: [userId], references: [id], onDelete: Cascade)
  changedBy User? @relation("CapacityChangeEditor", fields: [changedById], references: [id], onDelete: SetNull)

  @@index([userId])
}

// ─── Self-billing ───────────────────────────────────────────────────────────
// Move Hub raises each progressor's monthly commission invoice on their behalf
// under a signed agreement (wording: src/lib/selfBilling/agreementText.ts).
// Only completions/bonuses dated on or after the agreement start are
// self-billed; anything earlier stays on the upload (StaffInvoice) flow, so
// nothing can be invoiced both ways. Financial records: SetNull on users, never
// cascade, and kept for at least 6 years.

model SelfBillingAgreement {
  id               String    @id @default(cuid())
  userId           String?
  // Always the 1st of a month (UTC); endDate is the last day of a month, at
  // most 12 months after the start.
  startDate        DateTime
  endDate          DateTime
  version          String
  // The exact wording shown and signed, with the parties filled in.
  agreementText    String    @db.Text
  supplierSnapshot Json
  signedName       String
  signedAt         DateTime  @default(now())
  signedIp         String?
  moveHubSignatory String
  // Set when either side ends it early; endDate is then pulled in to the end
  // of the month, so self-billing stops from the next period.
  endedAt          DateTime?
  endedById        String?
  endReason        String?
  reminderSentAt   DateTime?
  createdAt        DateTime  @default(now())

  user     User?               @relation("AgreementOwner", fields: [userId], references: [id], onDelete: SetNull)
  endedBy  User?               @relation("AgreementEnder", fields: [endedById], references: [id], onDelete: SetNull)
  invoices SelfBilledInvoice[]

  @@index([userId])
}

model SelfBilledInvoice {
  id          String           @id @default(cuid())
  userId      String?
  agreementId String?
  kind        SelfBilledKind   @default(INVOICE)
  status      SelfBilledStatus @default(DRAFT)
  // Per-progressor sequence, assigned on issue (drafts have none).
  sequence    Int?
  number      String?
  periodYear  Int
  periodMonth Int

  netPence       Int    @default(0)
  vatPence       Int    @default(0)
  grossPence     Int    @default(0)
  vatRatePercent Float?

  // Problems found at generation (unmatched completions, incomplete details…).
  warnings Json?

  issuedAt            DateTime?
  issuedById          String?
  // When the clock for deemed acceptance (5 working days) started: issue, or
  // an admin confirming a queried invoice unchanged.
  acceptanceClockFrom DateTime?
  queriedAt           DateTime?
  queryNote           String?
  queryResponse       String?
  acceptedAt          DateTime?
  acceptedHow         AcceptedHow?
  paidAt              DateTime?
  voidedAt            DateTime?
  voidReason          String?

  // Frozen at issue: what the invoice says, whatever changes later.
  supplierSnapshot Json?
  customerSnapshot Json?
  pdfData          Bytes?

  originalInvoiceId String?
  replacesInvoiceId String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user        User?                   @relation("SelfBilledOwner", fields: [userId], references: [id], onDelete: SetNull)
  issuedBy    User?                   @relation("SelfBilledIssuer", fields: [issuedById], references: [id], onDelete: SetNull)
  agreement   SelfBillingAgreement?   @relation(fields: [agreementId], references: [id], onDelete: SetNull)
  original    SelfBilledInvoice?      @relation("CreditNotes", fields: [originalInvoiceId], references: [id], onDelete: SetNull)
  creditNotes SelfBilledInvoice[]     @relation("CreditNotes")
  replaces    SelfBilledInvoice?      @relation("Reissues", fields: [replacesInvoiceId], references: [id], onDelete: SetNull)
  replacedBy  SelfBilledInvoice[]     @relation("Reissues")
  lines       SelfBilledInvoiceLine[]

  @@unique([userId, sequence])
  @@index([userId])
  @@index([status])
  @@index([periodYear, periodMonth])
}

model SelfBilledInvoiceLine {
  id             String             @id @default(cuid())
  invoiceId      String
  type           SelfBilledLineType
  description    String
  amountPence    Int
  // For COMPLETION lines.
  matterAddress  String?
  completionDate DateTime?
  // Which month a PERFORMANCE_BONUS line is for — a late completion can raise
  // an earlier month's uplift, billed as a top-up on a later invoice.
  forYear        Int?
  forMonth       Int?
  sortOrder      Int                @default(0)

  invoice     SelfBilledInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  completions CompletedMatter[] @relation("LineCompletions")
  bonuses     BonusPayment[]    @relation("LineBonuses")

  @@index([invoiceId])
}

// ─── Singleton commission scheme settings ──────────────────────────────────

model Settings {
  id                        String    @id @default("singleton")
  commissionPerMatterPence  Int       @default(10000)
  bonusUpliftPercent        Float     @default(10)
  bonusThresholdNumerator   Int       @default(1)
  bonusThresholdDenominator Int       @default(3)
  // Matters completed before this date are never imported by the InTouch
  // sync, even on a first run — same safety valve as movehub-invoicing's
  // intouchSyncSinceDate.
  intouchSyncSinceDate      DateTime?
  updatedAt                 DateTime  @updatedAt
}
